# --- Database ---
# Async SQLAlchemy URL used by API and workers.
DATABASE_URL=postgresql+asyncpg://quickbite:quickbite@localhost:5432/quickbite
# Sync URL used by Alembic migrations.
SYNC_DATABASE_URL=postgresql+psycopg://quickbite:quickbite@localhost:5432/quickbite

# --- Broker ---
AMQP_URL=amqp://quickbite:quickbite@localhost:5672/%2F

# --- Auth ---
# MUST be overridden in .env; startup fails fast if left as placeholder.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated explicit origins. No wildcard with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Simulated stage delays (seconds, float) ---
PAYMENT_DELAY_S=0.2
RESTAURANT_DELAY_S=0.2
DELIVERY_DELAY_S=0.2
NOTIFICATION_DELAY_S=0.1

# --- Demo failure controls (env/scripts only; never checkout fields) ---
# payment: ok | fail-twice-then-succeed | always-fail | crash-before-commit | crash-after-commit-before-ack
PAYMENT_MODE=ok
# restaurant / delivery: ok | fail
RESTAURANT_MODE=ok
DELIVERY_MODE=ok
# notification: ok | fail
NOTIFICATION_MODE=ok

# --- Retry policy: 1 initial attempt + 3 retries at ~2s, 10s, 30s ---
RETRY_MAX_RETRIES=3
RETRY_DELAYS_S=2,10,30
